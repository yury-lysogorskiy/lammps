units           metal
atom_style      atomic
boundary        p p p

read_data       /home/users/lysogy36/CLionProjects/lammps-ace/test/GRACE-TESTS/energy-only-calc/test_structure_MDMC.lammps-data

pair_style      grace/2layer/chunk
pair_coeff      * * /home/users/lysogy36/CLionProjects/lammps-ace/test/GRACE-TESTS/potentials/GRACE-2L-OMAT-medium-base-aux W Mo

# Set masses just in case
mass            1 183.84
mass            2 95.95

# MC swap to trigger energy-only calls (5 attempts every 1 step)
# fix ID group-ID atom/swap N X seed T types type1 type2 ...
fix             mc all atom/swap 1 5 12345 300.0 types 1 2

thermo_style    custom step temp pe ke fmax f_mc[1] f_mc[2]
thermo          1
run             10
