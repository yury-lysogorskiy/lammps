units		metal
atom_style	atomic

neighbor	1 bin
neigh_modify	 every 1 delay 0 check yes

include struct.in

#####  PACE+Tensor potential ####
pair_style grace/2layer/chunk chunksize 1024

include pot.in

thermo_style  	custom step etotal pe ke temp press evdwl fmax pxx pyy pzz
thermo 		1
thermo_modify flush yes
dump pace_dump all custom 1 structure_chunked.dump id type x y z fx fy fz
dump_modify pace_dump sort id

run 0

run 5
undump pace_dump
