# LAMMPS script for W-BCC cubic cell with 512 atoms

units metal
atom_style atomic
boundary p p p

# Create BCC lattice for Tungsten (W)
lattice bcc 3.165  # Lattice constant for W in Angstroms
region box block 0 1 0 1 0 1  # Define a 4x4x4 unit cell region
create_box 1 box
create_atoms 1 box

replicate 8 8 8
# Define potential
pair_style grace 
#pair_coeff * * /home/users/lysogy36/.cache/grace/GRACE-2L-OMAT-large-ft-E-parallel-comm  W  

# Define simulation parameters
mass 1 183.84  # Atomic mass of W in amu
velocity all create 300.0 12345 mom yes rot yes dist gaussian

timestep 0.001  # 1 fs timestep
thermo 50  # Print thermodynamic data every 5 steps

# Run first MD simulation
fix 1 all nvt temp 300.0 300.0 0.1
run 
unfix 1

# Run second MD simulation
fix 2 all nvt temp 300.0 300.0 0.1
run 100
unfix 2

